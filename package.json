{
  "name": "e-prescription",
  "version": "1.0.0",
  "private": true,
  "description": "Local-network e-prescription handoff for a single channeling center.",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "postinstall": "node scripts/copy-vendor.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "pdfkit": "^0.21.0",
    "signature_pad": "5.1.7",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "nodemon": "^3.1.14",
    "pdf-parse": "^2.4.5",
    "socket.io-client": "^4.8.4"
  }
}
